{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Key": "",
    "Issuer": "nur-tricenter-gateway",
    "Audience": "nur-tricenter-api",
    "ExpiresMinutes": 60
  },

  "Auth": {
    "Usuarios": [
      {
        "Username": "admin",
        "Password": "admin123",
        "Roles": [ "admin", "integracion" ]
      },
      {
        "Username": "nutricionista",
        "Password": "nutri123",
        "Roles": [ "nutricionista" ]
      },
      {
        "Username": "cocina",
        "Password": "cocina123",
        "Roles": [ "cocina" ]
      },
      {
        "Username": "repartidor",
        "Password": "repartidor123",
        "Roles": [ "repartidor" ]
      }
    ]
  },

  "Login": {
    "IntentosPorMinuto": 10
  },

  "ReverseProxy": {
    "Routes": {
      "jsonplaceholder-users": {
        "ClusterId": "jsonplaceholder",
        "AuthorizationPolicy": "Autenticado",
        "Match": {
          "Path": "/api/users/{**resto}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "jsonplaceholder-posts": {
        "ClusterId": "jsonplaceholder",
        "AuthorizationPolicy": "Autenticado",
        "Match": {
          "Path": "/api/posts/{**resto}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      }
    },
    "Clusters": {
      "jsonplaceholder": {
        "Destinations": {
          "d1": {
            "Address": "https://jsonplaceholder.typicode.com"
          }
        }
      }
    }
  }
}
